# Wren reads this file at startup. Copy to .env and fill in what you have.

# Required for the brain (Claude). Without it Wren runs in mock mode.
ANTHROPIC_API_KEY=

# Voice. First one set wins; with none set, Wren uses the Mac's built-in voice and the browser's speech recognition.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Calendar feeds (comma-separated ICS URLs). Google Calendar: Settings > your calendar > "Secret address in iCal format".
WREN_ICS_URLS=

# Set to 1 to force mock mode even with a key (useful for testing the plumbing without spending anything).
WREN_MOCK_BRAIN=
