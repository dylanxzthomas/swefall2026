# Copy to .env.local. VITE_* values are public and included in the app bundle.
# Never put server credentials in VITE_* variables.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_NATIVE_CLIENT_ID=

# Set these in the matching Convex deployment's environment, not in the mobile bundle.
# Auth0 domain is the full issuer URL, e.g. https://tenant.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_NATIVE_CLIENT_ID=
# Auth0 M2M application restricted to Management API delete:users.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Explicit Auth0 subjects of disposable test accounts allowed to be deleted in development.
DAYMARK_TEST_AUTH0_SUBJECTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app: personal + work/school accounts; Web callback /microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
DAYMARK_TEST_MICROSOFT_EMAILS=
# AES-256-GCM key ring: JSON object from a key ID to a base64-encoded 32-byte key.
# Keep old keys while tokens are reencrypted on refresh. Never commit keys.
PROVIDER_TOKEN_KEYS=
PROVIDER_TOKEN_KEY_ID=
# Existing GOOGLE_TOKEN_KEYS / GOOGLE_TOKEN_KEY_ID remain supported for migration.
# Preserve their key IDs/values when moving to the provider-neutral names.
# Convex provides CONVEX_SITE_URL server-side. Google callback: /google/callback
DAYMARK_WEB_URL=
DAYMARK_ENVIRONMENT=development
# Comma-separated dedicated Google test accounts; required outside production.
DAYMARK_TEST_GOOGLE_EMAILS=
DAYMARK_TEST_EMAIL_RECIPIENTS=
ANTHROPIC_API_KEY=
DAYMARK_MODEL=
# Transactional caregiver email. Use a verified sending domain and dedicated test recipients.
RESEND_API_KEY=
DAYMARK_EMAIL_FROM=
# Verified inbound domain and email.received webhook at <CONVEX_SITE_URL>/inbound/resend.
DAYMARK_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Optional APNs token authentication; never put the P8 key in VITE_* settings.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# Deployment credentials are configured locally/CI, never committed.
CONVEX_DEPLOYMENT=
# Vercel Preview: project preview deploy key; Production: matching production deploy key.
CONVEX_DEPLOY_KEY=
# Release metadata only. Set after this exact model/prompt passed the live fixture gate.
DAYMARK_EVALUATED_MODEL=

# Legacy organizer only (.env, not needed by Daymark's cloud UI):
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# WREN_ICS_URLS=
# WREN_MOCK_BRAIN=

# Optional live voice: backend settings only, never VITE_* or browser storage.
OPENAI_API_KEY=
DAYMARK_VOICE_MODEL=gpt-realtime-2.1
