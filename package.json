{
  "name": "daymark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reviewed school calendar changes, caregiver pickups, and school emails.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/release-manifest.mjs",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "demo": "WREN_PROFILE=demo node --disable-warning=ExperimentalWarning --import tsx server/demo.ts",
    "demo:start": "WREN_PROFILE=demo node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "messaging:simulate": "node --disable-warning=ExperimentalWarning --import tsx server/messaging/simulate.ts",
    "test:messaging": "node --disable-warning=ExperimentalWarning --import tsx --test server/messaging/service.test.ts",
    "test:household": "node --disable-warning=ExperimentalWarning --import tsx --test server/household/household.test.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "test:mobile": "node --disable-warning=ExperimentalWarning --import tsx --test server/household/mobile.test.ts",
    "test:daymark": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "dev:backend": "node scripts/local-backend.mjs",
    "legacy:export": "node --disable-warning=ExperimentalWarning --import tsx server/household/export.ts",
    "test:local-backend": "node --import tsx tests/integration/local-backend.ts",
    "test:local-routines": "node --import tsx tests/integration/local-routines.ts",
    "eval:model": "node --import tsx tests/evals/run.ts",
    "test:native": "node scripts/native-check.mjs",
    "test:native-boundaries": "node scripts/native-boundaries.mjs",
    "ios:doctor": "node scripts/ios-preview.mjs --check",
    "ios:preview": "node scripts/ios-preview.mjs",
    "test:ios-tools": "node --test scripts/ios-simulator.test.mjs",
    "eval:conversation": "node --import tsx tests/evals/run-conversation.ts",
    "eval:email": "node --import tsx tests/evals/run-email.ts",
    "test:local-email": "node --import tsx tests/integration/local-email.ts",
    "test:local-mailbox": "node --import tsx tests/integration/local-mailbox.ts",
    "test:local-conversation": "node --import tsx tests/integration/local-conversation.ts",
    "test:local-mail-conversation": "node --import tsx tests/integration/local-mail-conversation.ts",
    "test:local-mail-followthrough": "node --import tsx tests/integration/local-mail-followthrough.ts",
    "test:local-mail-routines": "node --import tsx tests/integration/local-mail-routines.ts",
    "test:local-caregiver": "node --import tsx tests/integration/local-caregiver.ts",
    "test:local-assistant": "node --import tsx tests/integration/local-assistant.ts",
    "test:local-voice": "node --import tsx tests/integration/local-voice.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@auth0/auth0-react": "^2.27.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@convex-dev/workflow": "^0.4.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@googleapis/calendar": "^20.0.1",
    "@googleapis/gmail": "^22.0.1",
    "@hono/node-server": "^2.1.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.46.0",
    "google-auth-library": "^11.1.0",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.5",
    "motion": "^13.2.0",
    "node-ical": "^0.27.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svix": "^2.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.60",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
